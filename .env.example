# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0
ADMIN_TOKEN=change-me
MODELS_FILE=models.yaml

# Provider keys (leave blank for providers you don't use)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional local Ollama, e.g. http://localhost:11434/v1
OLLAMA_BASE_URL=

# Public playground: issue throwaway keys with tiny limits from POST /demo/keys
DEMO_ENABLED=false

# Upstream timeouts (seconds)
CONNECT_TIMEOUT_S=5
FIRST_TOKEN_TIMEOUT_S=20
TOTAL_TIMEOUT_S=120

# Default output-token cap used for cost estimates when client sends no max_tokens
DEFAULT_MAX_TOKENS=1024
